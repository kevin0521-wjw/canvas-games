【查 mkShot 签名】
  function mkShot(x, y, off, dmg, spd, pierce, col, homing) {
  return { x, y, vx: Math.cos(off) * spd, vy: Math.sin(off) * spd,
           r: 4, dmg, pierce, col, homing: homing || 0,
           hitSet: new Set(), age: 0, alive: true };
}

